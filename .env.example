# API Configuration
API_URL=http://localhost:8000

# Sentry (Optional)
SENTRY_DSN=

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Clerk Configuration (Required for authentication)
CLERK_SECRET_KEY=your-clerk-secret-key
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-app.clerk.accounts.dev

# Development/Testing: Disable authentication (WARNING: Only use in development!)
# When set to "true", all endpoints are accessible without authentication
# A mock test user with full access will be used automatically
DISABLE_AUTH=false
